{
  "name": "QueryTemplateAspect",
  "type": "record",
  "recordFields": [
    {
      "index": 1,
      "name": "nlQuery",
      "type": "string",
      "constraints": {
        "required": true
      },
      "annotations": {
        "displayName": "Natural Language Query",
        "description": "Original natural language user question."
      }
    },
    {
      "index": 2,
      "name": "parameterizedIntent",
      "type": "string",
      "constraints": {
        "required": true
      },
      "annotations": {
        "displayName": "Parameterized Intent",
        "description": "Explanation of query intent with analytical entities masked with placeholders."
      }
    },
    {
      "index": 3,
      "name": "parameterizedSql",
      "type": "string",
      "constraints": {
        "required": true
      },
      "annotations": {
        "displayName": "Parameterized SQL",
        "description": "The SQL template statement containing parameter placeholders for entity filling."
      }
    },
    {
      "index": 4,
      "name": "sql",
      "type": "string",
      "annotations": {
        "displayName": "SQL Statement",
        "description": "Raw or executed SQL statement representation."
      }
    }
  ],
  "annotations": {
    "displayName": "Query Template Aspect",
    "description": "Stores SQL templates, NL query, and parameterized intent for QueryData template matching."
  }
}

