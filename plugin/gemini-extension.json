{
  "name": "google-cloud-db-context-engineering",
  "version": "0.7.5",
  "contextFileName": "./GEMINI.md",
  "mcpServers": {
    "mcp_db_context_engineering": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${extensionPath}/..",
        "google-cloud-db-context-engineering"
      ]
    },
    "contextmgmt": {
      "httpUrl": "https://dataplex.googleapis.com/mcp/managed-context-sets",
      "authProviderType": "google_credentials",
      "oauth": {
        "scopes": ["https://www.googleapis.com/auth/cloud-platform"]
      }
    }
  }
}
