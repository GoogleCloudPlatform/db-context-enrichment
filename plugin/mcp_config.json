{
  "mcpServers": {
    "ctxeng": {
      "command": "uvx",
      "args": [
        "google-cloud-db-context-engineering@0.8.0"
      ]
    },
    "toolbox": {
      "command": "uvx",
      "args": [
        "toolbox-server@1.14.0",
        "--config",
        ".context-engineering/tools.yaml",
        "--stdio"
      ]
    },
    "ctxset": {
      "url": "https://dataplex.googleapis.com/mcp/managed-context-sets",
      "authProviderType": "google_credentials"
    }
  }
}
