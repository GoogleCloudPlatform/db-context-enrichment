# proto-file: google/cloud/dataplex/v1/catalog.proto
# proto-message: AspectType
name: "projects/${PROJECT_ID}/locations/${LOCATION_ID}/aspectTypes/query-template-aspect"
description: "Aspect storing SQL query template statements, natural language queries, and parameterized intent explanations aligned with QueryData."
display_name: "Query Template Aspect"
metadata_template {
  name: "QueryTemplateAspect"
  type: "record"
  record_fields {
    index: 1
    name: "nlQuery"
    type: "string"
    constraints {
      required: true
    }
    annotations {
      display_name: "Natural Language Query"
      description: "Original natural language user question."
    }
  }
  record_fields {
    index: 2
    name: "parameterizedIntent"
    type: "string"
    constraints {
      required: true
    }
    annotations {
      display_name: "Parameterized Intent"
      description: "Explanation of query intent with analytical entities masked with placeholders."
    }
  }
  record_fields {
    index: 3
    name: "parameterizedSql"
    type: "string"
    constraints {
      required: true
    }
    annotations {
      display_name: "Parameterized SQL"
      description: "The SQL template statement containing parameter placeholders for entity filling."
    }
  }
  record_fields {
    index: 4
    name: "sql"
    type: "string"
    annotations {
      display_name: "SQL Statement"
      description: "Raw or executed SQL statement representation."
    }
  }
  annotations {
    display_name: "Query Template Aspect"
    description: "Stores SQL templates, NL query, and parameterized intent for QueryData template matching."
  }
}