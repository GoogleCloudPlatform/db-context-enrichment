{
  "name": "db-context-engineering-dev",
  "description": "Local-dev variant. Loaded via `claude --plugin-dir`; MCP server runs from the working tree via `uv run`.",
  "version": "0.0.0-dev",
  "author": {
    "name": "Google Cloud Platform"
  },
  "mcpServers": {
    "ctxeng": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/..",
        "google-cloud-db-context-engineering"
      ]
    },
    "toolbox": {
      "command": "uvx",
      "args": [
        "toolbox-server@1.14.0",
        "--config",
        ".context-engineering/tools.yaml",
        "--stdio"
      ]
    },
    "ctxset": {
      "type": "http",
      "url": "https://dataplex.googleapis.com/mcp/managed-context-sets",
      "headersHelper": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/adc_headers.sh\""
    }
  }
}
