{
  "name": "google-cloud-db-context-engineering",
  "version": "0.8.0",
  "mcpServers": {
    "ctxeng": {
      "command": "uvx",
      "args": [
        "google-cloud-db-context-engineering@0.8.0"
      ]
    },
    "toolbox": {
      "command": "uvx",
      "args": [
        "toolbox-server@1.14.0",
        "--config",
        ".context-engineering/tools.yaml",
        "--stdio"
      ]
    },
    "ctxset": {
      "httpUrl": "https://dataplex.googleapis.com/mcp/managed-context-sets",
      "authProviderType": "google_credentials",
      "oauth": {
        "scopes": [
          "https://www.googleapis.com/auth/cloud-platform"
        ]
      }
    }
  }
}
