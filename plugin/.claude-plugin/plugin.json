{
  "name": "db-context-engineering",
  "description": "Context Engineering Agent for generating natural language to SQL templates, facets, and value searches.",
  "version": "0.8.0",
  "author": {
    "name": "Google Cloud Platform"
  },
  "mcpServers": {
    "ctxeng": {
      "command": "uvx",
      "args": [
        "google-cloud-db-context-engineering@0.8.0"
      ]
    },
    "toolbox": {
      "command": "uvx",
      "args": [
        "toolbox-server@1.14.0",
        "--config",
        ".context-engineering/tools.yaml",
        "--stdio"
      ]
    },
    "ctxset": {
      "type": "http",
      "url": "https://dataplex.googleapis.com/mcp/managed-context-sets",
      "headersHelper": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/adc_headers.sh\""
    }
  }
}
