{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "db-context-engineering": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "google-cloud-db-context-engineering@0.7.3"
      ]
    },
    "toolbox": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "toolbox-server@1.10.0",
        "--config",
        ".context-engineering/tools.yaml",
        "--stdio"
      ]
    },
    "contextmgmt": {
      "type": "streamable-http",
      "url": "https://dataplex.googleapis.com/mcp/managed-context-sets"
    }
  }
}
