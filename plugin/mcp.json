{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "db-context-engineering": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "google-cloud-db-context-engineering@0.7.2"
      ]
    },
    "toolbox": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "toolbox-server@1.9.0",
