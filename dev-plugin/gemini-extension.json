{
  "name": "google-cloud-db-context-engineering-dev",
  "version": "0.0.0-dev",
  "mcpServers": {
    "engine": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "<local-repo-path>",
        "google-cloud-db-context-engineering"
      ]
    },
    "toolbox": {
      "command": "uvx",
      "args": [
        "toolbox-server@1.14.0",
        "--config",
        ".context-engineering/tools.yaml",
        "--stdio"
      ]
    },
    "ctxset": {
      "httpUrl": "https://dataplex.googleapis.com/mcp/managed-context-sets",
      "authProviderType": "google_credentials",
      "oauth": {
        "scopes": ["https://www.googleapis.com/auth/cloud-platform"]
      }
    }
  }
}
